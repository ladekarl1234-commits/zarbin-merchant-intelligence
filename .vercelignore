# Vercel falls back to .gitignore when this file is absent, which would drop
# data/marts — the parquet the function queries. This file replaces that fallback:
# marts IN, everything a serverless function cannot use OUT.
.git
.github
# `vercel link` writes .env.local with a VERCEL_OIDC_TOKEN. Because this file replaces the
# .gitignore fallback, that credential would otherwise be uploaded into the function bundle —
# not web-reachable (nothing serves it), but a secret has no business in a deploy artifact.
.env
.env.*
.vercel
.venv
.vscode
.claude
.impeccable
.playwright-cli
.pytest_cache
.ruff_cache
node_modules
frontend
tests
docs
specs
scripts
pipeline
my prompt
data orgin
uv.lock
Dockerfile
docker-compose.yml
*.png
*.md
!README.md

# dataset: the 59 MB source CSV is rebuilt into marts offline; only the marts ship
data/other_challenge_data.csv.gz
data/telemetry
